<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enquire for <%= spare.title %> | <%= settings.companyName %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />

    <!-- Open Graph / WhatsApp / Facebook Link Sharing Preview -->
    <meta property="og:type" content="product" />
    <meta property="og:title" content="Enquire for <%= spare.title %> | <%= settings.companyName %>" />
    <meta property="og:description" content="<%= spare.details %>" />
    <meta property="og:image" content="<%= spare.imageSrc || settings.companyLogoUrl || '/logo.svg' %>" />
    <meta property="og:image:alt" content="<%= spare.title %>" />

    <!-- Twitter Cards Preview -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Enquire for <%= spare.title %> | <%= settings.companyName %>" />
    <meta name="twitter:description" content="<%= spare.details %>" />
    <meta name="twitter:image" content="<%= spare.imageSrc || settings.companyLogoUrl || '/logo.svg' %>" />
  </head>
  <body>
    <!-- Main Header -->
    <header>
      <div class="container navbar">
        <a href="/" class="brand-wrapper">
          <div class="brand-logo-wrap">
            <img src="<%= settings.companyLogoUrl || '/logo.svg' %>" alt="<%= settings.companyName %> logo" class="brand-logo-img" />
          </div>
          <span class="brand"><%= settings.companyName %></span>
        </a>

        <nav class="nav-links">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link active" href="/products">Products</a>
          <a class="nav-link" href="/#about">About Us</a>
          <a class="nav-link" href="/contact">Contact Us</a>
        </nav>

        <div class="nav-actions">
          <a href="tel:<%= settings.companyPhone %>" class="nav-cta-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Call Now</span>
          </a>
          <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Nav Drawer -->
    <div class="mobile-nav-drawer" id="mobileDrawer">
      <a class="nav-link" href="/">Home</a>
      <a class="nav-link" href="/products">Products</a>
      <a class="nav-link" href="/#about">About Us</a>
      <a class="nav-link" href="/contact">Contact Us</a>
      <div class="mobile-contact-card">
        <p><strong>Direct Helpline:</strong></p>
        <p><a href="tel:<%= settings.companyPhone %>"><%= settings.companyPhone %></a></p>
        <p><strong>Email Support:</strong></p>
        <p><a href="mailto:<%= settings.companyEmail %>"><%= settings.companyEmail %></a></p>
        <a href="/contact" class="btn btn-primary btn-block" style="margin-top: 0.8rem;">Send Direct Enquiry</a>
      </div>
    </div>

    <!-- Enquiry Form Container -->
    <div class="container" style="padding-top: 2rem; padding-bottom: 3.5rem;">
      <!-- Breadcrumb -->
      <nav style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
        <a href="/" style="color: var(--primary); font-weight: 600;">Home</a>
        <span>/</span>
        <a href="/products" style="color: var(--primary); font-weight: 600;">Products</a>
        <span>/</span>
        <span>Enquiry</span>
      </nav>

      <div class="card form-card reveal" style="max-width: 760px; margin: 0 auto; padding: 2.25rem;">
        <!-- Product Preview Card -->
        <div style="display: flex; gap: 1.5rem; align-items: center; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.75rem; flex-wrap: wrap;">
          <div style="width: 120px; height: 95px; border-radius: var(--radius-md); overflow: hidden; background: #f1f5f9; border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
            <% if (spare.imageSrc) { %>
              <img src="<%= spare.imageSrc %>" alt="<%= spare.imageAlt || spare.title %>" style="width: 100%; height: 100%; object-fit: cover;" />
            <% } else { %>
              <svg style="width: 40px; height: 40px; color: #94a3b8;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            <% } %>
          </div>
          <div style="flex: 1; min-width: 220px;">
            <span class="badge" style="margin-bottom: 0.35rem;"><%= spare.category %></span>
            <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--primary); margin-bottom: 0.3rem;"><%= spare.title %></h2>
            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.45;"><%= spare.details %></p>
          </div>
        </div>

        <div class="form-header" style="text-align: left; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--primary);">Request Price &amp; Availability</h3>
          <p>Provide your delivery requirement below to receive an official quote with stock status.</p>
        </div>

        <form method="post" action="/enquire/<%= spare.id %>">
          <div class="form-group">
            <label for="customerName">Your Full Name *</label>
            <input id="customerName" required name="customerName" placeholder="e.g. Anand Sharma" autocomplete="name" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;" class="admin-grid">
            <div class="form-group">
              <label for="mobileNumber">Mobile Number *</label>
              <input id="mobileNumber" required type="tel" name="mobileNumber" placeholder="e.g. +91 98765 43210" inputmode="tel" autocomplete="tel" />
            </div>

            <div class="form-group">
              <label for="emailId">Email Address *</label>
              <input id="emailId" required type="email" name="emailId" placeholder="e.g. anand@precisionworks.in" autocomplete="email" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;" class="admin-grid">
            <div class="form-group">
              <label for="companyName">Company / Workshop Name (Optional)</label>
              <input id="companyName" name="companyName" placeholder="e.g. Apex Precision Tooling" autocomplete="organization" />
            </div>

            <div class="form-group">
              <label for="gstinNumber">GSTIN Number (Optional)</label>
              <input id="gstinNumber" name="gstinNumber" placeholder="e.g. 33AAAAA0000A1Z5" />
            </div>
          </div>

          <div class="form-group">
            <label for="quantity">Quantity Required *</label>
            <div class="quantity-stepper">
              <button type="button" class="stepper-btn stepper-minus" aria-label="Decrease quantity">−</button>
              <input id="quantity" class="stepper-input" required type="number" min="1" name="quantity" value="1" />
              <button type="button" class="stepper-btn stepper-plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div style="background: var(--surface-alt); border-radius: var(--radius-md); padding: 0.9rem 1.1rem; border: 1px solid var(--border); margin-top: 1.25rem;">
            <p style="font-size: 0.84rem; color: var(--text-muted); margin: 0;">
              🔒 <strong>No payment required now.</strong> Our technical engineer will verify compatibility with your CNC system and send wholesale pricing with dispatch estimates.
            </p>
          </div>

          <div class="form-actions">
            <button class="btn btn-primary" type="submit" style="min-width: 200px;">
              <span>Submit Enquiry</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
            <a class="btn btn-secondary" href="/products">Back to Catalog</a>
          </div>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <h3><%= settings.companyName %></h3>
          <p>Delivering dependable CNC spare parts sales and engineering support for workshops and manufacturing units nationwide.</p>
        </div>
        
        <div class="footer-col">
          <h4>Navigation</h4>
          <ul class="footer-links-list">
            <li><a href="/">Home</a></li>
            <li><a href="/products">All Products</a></li>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/contact">Contact &amp; Enquiry</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Contact Support</h4>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div>
              <a href="tel:<%= settings.companyPhone %>"><%= settings.companyPhone %></a>
              <div class="small" style="color: #94a3b8; font-size: 0.82rem;">Monday to Friday 09:00 AM to 05:30PM</div>
            </div>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:<%= settings.companyEmail %>"><%= settings.companyEmail %></a>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span><%= settings.companyAddress %></span>
          </div>
        </div>
      </div>

      <div class="container footer-bottom-divider">
        <div class="footer-copyright">
          © <%= new Date().getFullYear() %> <%= settings.companyName %>. All rights reserved.
        </div>
        <div class="footer-developer-credit">
          <a href="https://www.netcraftstudios.org" target="_blank" rel="noopener noreferrer">Developed by Netcraft Studio</a>
        </div>
      </div>
    </footer>

    <script src="/app.js"></script>
  </body>
</html>
