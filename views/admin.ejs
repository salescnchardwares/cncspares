<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Overview | <%= settings.companyName %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body style="background: var(--bg);">
    <div class="container" style="padding: 2rem 0 4rem;">
      <!-- Admin Header Bar -->
      <div class="admin-header-bar">
        <div class="admin-brand">
          <div class="brand-logo-wrap" style="width: 38px; height: 38px;">
            <img src="<%= settings.companyLogoUrl || '/logo.svg' %>" alt="<%= settings.companyName %> logo" class="brand-logo-img" />
          </div>
          <span><%= settings.companyName %> Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a class="btn admin-nav-btn active" href="/Updates">Dashboard</a>
          <a class="btn admin-nav-btn" href="/Updates/company">Company Details</a>
          <a class="btn admin-nav-btn" href="/Updates/spares">Manage Spares</a>
          <a class="btn admin-nav-btn" href="/Updates/orders">Enquiries &amp; Orders</a>
          <a class="btn admin-nav-btn" href="/Updates/password">Security</a>
          <a class="btn admin-nav-btn logout" href="/Updates/logout">Logout</a>
        </nav>
      </div>

      <!-- Welcome Banner -->
      <div class="card admin-card reveal" style="border-left: 5px solid var(--accent); background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);">
        <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--primary); margin-bottom: 0.35rem;">Admin Overview</h3>
        <p class="muted" style="margin: 0; font-size: 0.95rem;">Manage company contact info, update parts catalog inventory, track customer enquiries, and monitor visitor analytics.</p>
        <div style="margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/Updates/spares" class="btn btn-primary btn-sm">+ Add New Spare</a>
          <a href="/Updates/orders" class="btn btn-secondary btn-sm">View Enquiries (<%= inquiries.length %>)</a>
          <a href="/" target="_blank" class="btn btn-secondary btn-sm">View Public Website ↗</a>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="analytics-grid" style="margin-bottom: 1.5rem;">
        <div class="analytics-metric">
          <span class="metric-label">Spares Listed</span>
          <strong><%= spares.length %></strong>
          <div class="small" style="margin-top: 0.25rem;"><a href="/Updates/spares" style="color: var(--secondary);">Manage spares ↗</a></div>
        </div>

        <div class="analytics-metric">
          <span class="metric-label">Total Enquiries</span>
          <strong><%= inquiries.length %></strong>
          <div class="small" style="margin-top: 0.25rem;"><a href="/Updates/orders" style="color: var(--secondary);">Review orders ↗</a></div>
        </div>

        <div class="analytics-metric">
          <span class="metric-label">Website Visits</span>
          <strong><%= analyticsVisits %></strong>
          <div class="small" style="margin-top: 0.25rem; color: <%= analyticsEnabled ? 'var(--success)' : 'var(--text-muted)' %>;">
            ● <%= analyticsEnabled ? 'Tracking Active' : 'Tracking Paused' %>
          </div>
        </div>

        <div class="analytics-metric">
          <span class="metric-label">Company Email</span>
          <strong style="font-size: 0.95rem; word-break: break-all;"><%= settings.companyEmail %></strong>
          <div class="small" style="margin-top: 0.25rem;"><a href="/Updates/company" style="color: var(--secondary);">Edit settings ↗</a></div>
        </div>
      </div>

      <!-- Traffic Analytics Control Card -->
      <div class="card admin-card analytics-card reveal">
        <div class="analytics-header">
          <div>
            <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--primary); margin-bottom: 0.2rem;">Website Traffic Analytics</h3>
            <p class="muted" style="margin: 0; font-size: 0.9rem;">Toggle visitor tracking on or off manually. Visits increment each time public pages are viewed.</p>
          </div>
          <form method="post" action="/Updates/analytics-toggle" class="analytics-toggle-form">
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--primary);">
              <%= analyticsEnabled ? 'Enabled' : 'Disabled' %>
            </span>
            <label class="toggle-switch">
              <input type="checkbox" name="analyticsEnabled" <%= analyticsEnabled ? 'checked' : '' %> onchange="this.form.submit()" />
              <span class="toggle-slider"></span>
            </label>
            <button class="btn btn-primary btn-sm" type="submit">Save</button>
          </form>
        </div>

        <div class="analytics-grid">
          <div class="analytics-metric">
            <span class="metric-label">Status</span>
            <strong style="color: <%= analyticsEnabled ? 'var(--success)' : 'var(--danger)' %>;"><%= analyticsEnabled ? 'Active' : 'Disabled' %></strong>
          </div>
          <div class="analytics-metric">
            <span class="metric-label">Total Visits</span>
            <strong><%= analyticsVisits %></strong>
          </div>
          <div class="analytics-metric">
            <span class="metric-label">Tracking Mode</span>
            <strong>Manual Session</strong>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
