<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products &amp; Spares Catalog | <%= settings.companyName %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />

    <!-- Open Graph / WhatsApp / Facebook Link Sharing Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Products &amp; Spares Catalog | <%= settings.companyName %>" />
    <meta property="og:description" content="Browse <%= spares.length %>+ precision CNC spares, cables, encoders, and tooling components with direct wholesale pricing." />
    <meta property="og:image" content="<%= settings.companyLogoUrl || '/logo.svg' %>" />
    <meta property="og:image:alt" content="<%= settings.companyName %> Logo" />

    <!-- Twitter Cards Preview -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Products &amp; Spares Catalog | <%= settings.companyName %>" />
    <meta name="twitter:description" content="Browse <%= spares.length %>+ precision CNC spares, cables, encoders, and tooling components with direct wholesale pricing." />
    <meta name="twitter:image" content="<%= settings.companyLogoUrl || '/logo.svg' %>" />
  </head>
  <body>
    <!-- Main Header -->
    <header>
      <div class="container navbar">
        <a href="/" class="brand-wrapper">
          <div class="brand-logo-wrap">
            <img src="<%= settings.companyLogoUrl || '/logo.svg' %>" alt="<%= settings.companyName %> logo" class="brand-logo-img" />
          </div>
          <span class="brand"><%= settings.companyName %></span>
        </a>

        <nav class="nav-links">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link active" href="/products">Products</a>
          <a class="nav-link" href="/#about">About Us</a>
          <a class="nav-link" href="/contact">Contact Us</a>
        </nav>

        <div class="nav-actions">
          <a href="tel:<%= settings.companyPhone %>" class="nav-cta-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Call Now</span>
          </a>
          <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Nav Drawer -->
    <div class="mobile-nav-drawer" id="mobileDrawer">
      <a class="nav-link" href="/">Home</a>
      <a class="nav-link active" href="/products">Products</a>
      <a class="nav-link" href="/#about">About Us</a>
      <a class="nav-link" href="/contact">Contact Us</a>
      <div class="mobile-contact-card">
        <p><strong>Direct Helpline:</strong></p>
        <p><a href="tel:<%= settings.companyPhone %>"><%= settings.companyPhone %></a></p>
        <p><strong>Email Support:</strong></p>
        <p><a href="mailto:<%= settings.companyEmail %>"><%= settings.companyEmail %></a></p>
        <a href="/contact" class="btn btn-primary btn-block" style="margin-top: 0.8rem;">Send Direct Enquiry</a>
      </div>
    </div>

    <!-- Page Banner -->
    <div style="background: linear-gradient(135deg, #071526 0%, #0c2340 100%); color: #ffffff; padding: 2.75rem 0 2.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
      <div class="container">
        <div class="hero-eyebrow" style="margin-bottom: 0.75rem;">
          <span class="pulse-dot"></span>
          Industrial Grade Spares
        </div>
        <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; margin-bottom: 0.5rem;">CNC Spare Parts &amp; Engineering Services</h1>
        <p style="color: #cbd5e1; max-width: 680px; font-size: 1.05rem;">Search and filter through our certified spare parts inventory or reach out to our team for custom component procurement.</p>
      </div>
    </div>

    <!-- All Products Catalog Section -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Inventory Catalog</span>
          <h2>All Available Products (<%= spares.length %>)</h2>
          <p class="muted">Wholesale pricing is provided upon requirement request. Filter by category or search by part name below.</p>
        </div>

        <!-- Search and Category Filters -->
        <div class="catalog-controls">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="catalogSearch" class="search-input" placeholder="Search by spare name, code, or description..." aria-label="Search spare parts" />
          </div>

          <% 
            const uniqueCategories = Array.from(new Set(spares.map(s => s.category).filter(Boolean)));
          %>
          <div class="category-pills">
            <button class="category-pill active" data-category="all">All Spares (<%= spares.length %>)</button>
            <% uniqueCategories.forEach(function(cat) { %>
              <button class="category-pill" data-category="<%= cat %>"><%= cat %></button>
            <% }) %>
          </div>
        </div>

        <!-- Spares Grid -->
        <div class="grid">
          <% spares.forEach(function(spare) { %>
            <div class="card spare-card reveal" data-category="<%= spare.category %>">
              <div class="spare-image-wrap">
                <% if (spare.imageSrc) { %>
                  <img src="<%= spare.imageSrc %>" alt="<%= spare.imageAlt || spare.title %>" loading="lazy" />
                <% } else { %>
                  <div class="spare-image-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="12" cy="12" r="3"></circle>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    <span style="font-size: 0.8rem; font-weight: 600;">CNC Hardware</span>
                  </div>
                <% } %>
              </div>
              <div class="spare-card-body">
                <span class="badge"><%= spare.category %></span>
                <h3><%= spare.title %></h3>
                <p><%= spare.details %></p>
              </div>
              <div class="spare-card-footer">
                <a class="btn btn-primary btn-block" href="/enquire/<%= spare.id %>">
                  <span>Enquire Now</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Empty search/filter state -->
        <div id="emptyCatalogState" class="card text-center hidden" style="padding: 3rem 1.5rem; margin-top: 1.5rem;">
          <svg style="width: 48px; height: 48px; margin: 0 auto 1rem; color: #94a3b8;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--primary); margin-bottom: 0.5rem;">No spare parts found</h3>
          <p class="muted" style="max-width: 440px; margin: 0 auto 1.25rem;">We may still have this part or can source it directly for your machine. Send us a custom requirement.</p>
          <a href="/contact" class="btn btn-primary" style="display: inline-flex;">Send Custom Enquiry</a>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-header centered">
          <span class="section-eyebrow">Engineering Capabilities</span>
          <h2>Products &amp; Technical Services</h2>
          <p class="muted">In addition to spare supplies, we provide precision maintenance and electrical repair services for production machinery.</p>
        </div>
        <div class="services-grid">
          <% services.forEach(function(service) { %>
            <div class="service-card reveal">
              <div class="service-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3><%= service.title %></h3>
              <p><%= service.description %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <h3><%= settings.companyName %></h3>
          <p>Delivering dependable CNC spare parts sales and engineering support for workshops and manufacturing units nationwide.</p>
        </div>
        
        <div class="footer-col">
          <h4>Quick Navigation</h4>
          <ul class="footer-links-list">
            <li><a href="/">Home</a></li>
            <li><a href="/products">All Products</a></li>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/contact">Contact &amp; Enquiry</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Contact Support</h4>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div>
              <a href="tel:<%= settings.companyPhone %>"><%= settings.companyPhone %></a>
              <div class="small" style="color: #94a3b8; font-size: 0.82rem;">Monday to Friday 09:00 AM to 05:30PM</div>
            </div>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:<%= settings.companyEmail %>"><%= settings.companyEmail %></a>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span><%= settings.companyAddress %></span>
          </div>
        </div>
      </div>

      <div class="container footer-bottom-divider">
        <div class="footer-copyright">
          © <%= new Date().getFullYear() %> <%= settings.companyName %>. All rights reserved.
        </div>
        <div class="footer-developer-credit">
          <a href="https://www.netcraftstudios.org" target="_blank" rel="noopener noreferrer">Developed by Netcraft Studio</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Quick Action Sticky Bar -->
    <div class="mobile-bottom-bar">
      <div class="mobile-bottom-bar-inner">
        <a href="tel:<%= settings.companyPhone %>" class="mobile-action-btn mobile-call-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>Call Support</span>
        </a>
        <a href="/contact" class="mobile-action-btn mobile-enquiry-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          <span>Send Enquiry</span>
        </a>
      </div>
    </div>

    <script src="/app.js"></script>
  </body>
</html>
