<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Spares | Admin Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body style="background: var(--bg);">
    <div class="container" style="padding: 2rem 0 4rem;">
      <!-- Admin Header Bar -->
      <div class="admin-header-bar">
        <div class="admin-brand">
          <div class="brand-logo-wrap" style="width: 38px; height: 38px;">
            <img src="<%= settings.companyLogoUrl || '/logo.svg' %>" alt="<%= settings.companyName %> logo" class="brand-logo-img" />
          </div>
          <span><%= settings.companyName %> Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a class="btn admin-nav-btn" href="/Updates">Dashboard</a>
          <a class="btn admin-nav-btn" href="/Updates/company">Company Details</a>
          <a class="btn admin-nav-btn active" href="/Updates/spares">Manage Spares</a>
          <a class="btn admin-nav-btn" href="/Updates/orders">Enquiries &amp; Orders</a>
          <a class="btn admin-nav-btn" href="/Updates/password">Security</a>
          <a class="btn admin-nav-btn logout" href="/Updates/logout">Logout</a>
        </nav>
      </div>

      <!-- Add / Edit Spare Card -->
      <div class="card admin-card reveal">
        <div class="admin-section-header">
          <div>
            <h3><%= editingSpare ? 'Edit Spare Part' : 'Add New Spare Part' %></h3>
            <p class="muted" style="margin: 0; font-size: 0.9rem;">
              <%= editingSpare ? `Editing "${editingSpare.title}"` : 'Enter the part specifications and image to publish to the catalog.' %>
            </p>
          </div>
          <% if (editingSpare) { %>
            <a class="btn btn-secondary btn-sm" href="/Updates/spares">Cancel Edit</a>
          <% } %>
        </div>

        <form method="post" action="/Updates/spares" enctype="multipart/form-data">
          <input type="hidden" name="id" value="<%= editingSpare ? editingSpare.id : '' %>" />

          <div class="admin-grid">
            <div>
              <div class="form-group">
                <label for="spareTitle">Spare Part Title *</label>
                <input id="spareTitle" name="title" value="<%= editingSpare ? editingSpare.title : '' %>" placeholder="e.g. Spindle Bearing Set B7010C" required />
              </div>

              <div class="form-group">
                <label for="spareCategory">Category *</label>
                <input id="spareCategory" name="category" value="<%= editingSpare ? editingSpare.category : '' %>" placeholder="e.g. Spindle Parts, Drive Components, Sensors" required />
              </div>

              <div class="form-group">
                <label for="spareDetails">Details &amp; Specifications *</label>
                <textarea id="spareDetails" name="details" placeholder="Describe compatibility, machine models, connector types, dimensions, and condition..." required style="min-height: 140px;"><%= editingSpare ? editingSpare.details : '' %></textarea>
              </div>
            </div>

            <div>
              <div class="form-group">
                <label for="imageFile">Upload Photo (Cloudinary)</label>
                <input id="imageFile" name="imageFile" type="file" accept="image/*" />
                <div class="input-help">Will be uploaded to your Cloudinary storage if configured.</div>
              </div>

              <div class="form-group">
                <label for="imageUrl">Direct Image URL</label>
                <input id="imageUrl" name="imageUrl" value="<%= editingSpare ? (editingSpare.imageUrl || '') : '' %>" placeholder="https://..." />
                <div class="input-help">Alternatively, paste an existing image link.</div>
              </div>

              <div class="form-group">
                <label for="imagePublicId">Image Public ID (Optional)</label>
                <input id="imagePublicId" name="imagePublicId" value="<%= editingSpare ? (editingSpare.imagePublicId || '') : '' %>" placeholder="cloudinary-public-id" />
              </div>

              <div class="form-group">
                <label for="imageAlt">Image Alt Text (Accessibility)</label>
                <input id="imageAlt" name="imageAlt" value="<%= editingSpare ? (editingSpare.imageAlt || '') : '' %>" placeholder="Describe image" />
              </div>
            </div>
          </div>

          <div class="form-actions" style="border-top: 1px solid var(--border); padding-top: 1.25rem;">
            <button class="btn btn-primary" type="submit" style="min-width: 180px;">
              <span><%= editingSpare ? 'Update Spare' : 'Publish Spare' %></span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
            <% if (editingSpare) { %>
              <a class="btn btn-secondary" href="/Updates/spares">Cancel</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Existing Spares Inventory -->
      <div class="card admin-card reveal">
        <div class="admin-section-header">
          <div>
            <h3>Existing Spare Parts (<%= spares.length %>)</h3>
            <p class="muted" style="margin: 0; font-size: 0.9rem;">Catalog items currently displayed on the website.</p>
          </div>
        </div>

        <% if (spares.length === 0) { %>
          <div style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
            No spare parts found. Use the form above to add your first spare part.
          </div>
        <% } else { %>
          <div style="display: flex; flex-direction: column;">
            <% spares.forEach(function(spare) { %>
              <div class="admin-spare-item">
                <div class="admin-spare-info">
                  <% if (spare.imageUrl) { %>
                    <img class="admin-spare-thumb" src="<%= spare.imageUrl %>" alt="<%= spare.imageAlt || spare.title %>" />
                  <% } else { %>
                    <div class="admin-spare-thumb" style="display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </div>
                  <% } %>
                  <div>
                    <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--primary); margin-bottom: 0.2rem;"><%= spare.title %></h4>
                    <span class="badge" style="font-size: 0.76rem; padding: 0.15rem 0.55rem;"><%= spare.category %></span>
                    <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.35rem; line-height: 1.4;"><%= spare.details %></p>
                  </div>
                </div>

                <div style="display: flex; gap: 0.5rem; align-items: center;">
                  <a class="btn btn-secondary btn-sm" href="/Updates/spares/<%= spare.id %>/edit">Edit</a>
                  <form method="post" action="/Updates/spares/delete" class="admin-inline-form" onsubmit="return confirm('Are you sure you want to remove this spare part?');">
                    <input type="hidden" name="id" value="<%= spare.id %>" />
                    <button class="btn btn-sm" type="submit" style="background: var(--danger-soft); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2);">Delete</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </body>
</html>
