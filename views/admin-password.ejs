<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password | Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/site.css" />
  </head>
  <body>
    <div class="container" style="padding: 2rem 0 3rem;">
      <div class="navbar" style="margin-bottom: 1rem;">
        <div class="brand">Admin Dashboard</div>
        <div class="nav-links">
          <a class="btn btn-secondary admin-nav-btn" href="/admin/company">Company</a>
          <a class="btn btn-secondary admin-nav-btn" href="/admin/spares">Spares</a>
          <a class="btn btn-secondary admin-nav-btn" href="/admin/orders">Orders</a>
          <a class="btn btn-secondary admin-nav-btn" href="/admin/password">Password</a>
          <a class="btn btn-secondary admin-nav-btn" href="/admin/logout">Logout</a>
        </div>
      </div>

      <div class="card admin-card">
        <h3>Change Admin Password</h3>
        <% if (message) { %>
          <div class="alert"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert" style="background:#fff5f5;color:#b42318;border-color:#f2b6b6;"><%= error %></div>
        <% } %>
        <form method="post" action="/admin/password">
          <label>Current Password</label>
          <input name="currentPassword" type="password" required />
          <label>New Password</label>
          <input name="newPassword" type="password" required />
          <label>Confirm New Password</label>
          <input name="confirmPassword" type="password" required />
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Update Password</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
