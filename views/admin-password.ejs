<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security &amp; Password | Admin Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body style="background: var(--bg);">
    <div class="container" style="padding: 2rem 0 4rem;">
      <!-- Admin Header Bar -->
      <div class="admin-header-bar">
        <div class="admin-brand">
          <div class="brand-logo-wrap" style="width: 38px; height: 38px;">
            <img src="<%= settings.companyLogoUrl || '/logo.svg' %>" alt="<%= settings.companyName %> logo" class="brand-logo-img" />
          </div>
          <span><%= settings.companyName %> Admin</span>
        </div>

        <nav class="admin-nav-links">
          <a class="btn admin-nav-btn" href="/Updates">Dashboard</a>
          <a class="btn admin-nav-btn" href="/Updates/company">Company Details</a>
          <a class="btn admin-nav-btn" href="/Updates/spares">Manage Spares</a>
          <a class="btn admin-nav-btn" href="/Updates/orders">Enquiries &amp; Orders</a>
          <a class="btn admin-nav-btn active" href="/Updates/password">Security</a>
          <a class="btn admin-nav-btn logout" href="/Updates/logout">Logout</a>
        </nav>
      </div>

      <!-- Change Password Card -->
      <div class="card form-card reveal" style="max-width: 580px; margin: 0 auto; padding: 2.25rem;">
        <div class="form-header" style="text-align: left; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--primary);">Update Admin Password</h3>
          <p>Ensure your account remains protected with a strong, distinct password.</p>
        </div>

        <% if (message) { %>
          <div class="alert">
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span><%= message %></span>
          </div>
        <% } %>

        <% if (error) { %>
          <div class="alert alert-error">
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="post" action="/Updates/password">
          <div class="form-group">
            <label for="currentPassword">Current Password *</label>
            <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" placeholder="••••••••••••" />
          </div>

          <div class="form-group">
            <label for="newPassword">New Password *</label>
            <input id="newPassword" name="newPassword" type="password" required autocomplete="new-password" placeholder="At least 6 characters" />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm New Password *</label>
            <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password" placeholder="Re-type new password" />
          </div>

          <div class="form-actions" style="margin-top: 2rem;">
            <button class="btn btn-primary" type="submit" style="min-width: 180px;">
              <span>Update Password</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
            <a class="btn btn-secondary" href="/Updates">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
